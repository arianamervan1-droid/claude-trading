RH_USERNAME=
RH_PASSWORD=
# Base32 secret from Robinhood's authenticator-app 2FA setup (optional but needed for unattended runs)
RH_MFA_SECRET=
# Symbols to trade, comma separated
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA
# paper (default) or live
MODE=paper
# Set to YES_I_UNDERSTAND_THE_RISK to allow real orders
LIVE_CONFIRM=
